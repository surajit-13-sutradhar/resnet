runs/
tensorboard/

# =========================
# Data
# =========================

# Downloaded datasets
data/*

# Keep the directory itself
!data/.gitkeep

# Specifically ignore compressed datasets
*.tar.gz
*.zip
*.7z

# =========================
# Experiment Outputs
# =========================
experiments/*
results/*

# Keep directories
!experiments/.gitkeep
!results/.gitkeep

# =========================
# Logs
# =========================
*.log
logs/

# =========================
# Environment / Secrets
# =========================
.env
.env.*
!.env.example

# =========================
